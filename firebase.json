{
  "hosting": {
    "site": "kehila-admin-386ab",
    "public": "dist",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build"
    ],
    "ignore": ["**/.*"],
    "redirects": [
      {
        "regex": "^/app-admin/?(?P<rest>.*)$",
        "destination": "https://kehila-app.com/console/:rest",
        "type": 302
      }
    ],
    "rewrites": [
      { "source": "/privacy", "destination": "/privacy.html" },
      { "source": "/delete-account", "destination": "/delete-account.html" },
      { "source": "/guides", "destination": "/guides/index.html" },
      { "source": "/guides/**", "destination": "/guides/index.html" },
      { "source": "/console", "destination": "/console/index.html" },
      { "source": "/console/**", "destination": "/console/index.html" }
    ],
    "headers": [
      {
        "source": "/console/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/guides/videos/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "/guides/guides.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "{/,/privacy,/delete-account,/console,/console/}",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
